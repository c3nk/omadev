# Maintainer: c3nk
# Prebuilt binary package. At each release, update pkgver and the sha256 values
# below from the release SHA256SUMS file so installs are verified (SECURITY.md, S11).
pkgname=omadev-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="A developer experience CLI designed for Omarchy (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/c3nk/omadev"
license=('MIT')
provides=('omadev')
conflicts=('omadev')
source_x86_64=("omadev-v${pkgver}-linux-amd64::${url}/releases/download/v${pkgver}/omadev-v${pkgver}-linux-amd64")
source_aarch64=("omadev-v${pkgver}-linux-arm64::${url}/releases/download/v${pkgver}/omadev-v${pkgver}-linux-arm64")
sha256sums_x86_64=('b6eace1805b8d285c85570dbe74b9a7d37790a02e241b084244a4296e332859f')
sha256sums_aarch64=('84e660f357c6dd258ab9361f929c3969e5feb1d41a4a0d63a7ef7de4f8a829cb')

package() {
  case "$CARCH" in
    x86_64) _bin="omadev-v${pkgver}-linux-amd64" ;;
    aarch64) _bin="omadev-v${pkgver}-linux-arm64" ;;
  esac
  install -Dm755 "${srcdir}/${_bin}" "${pkgdir}/usr/bin/omadev"
}
