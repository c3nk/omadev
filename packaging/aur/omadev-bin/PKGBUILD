# Maintainer: c3nk
# Prebuilt binary package. At each release, update pkgver and replace the SKIP
# checksums with the real values from the release SHA256SUMS file so installs are
# verified (see SECURITY.md, S11).
pkgname=omadev-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="A developer experience CLI designed for Omarchy (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/c3nk/omadev"
license=('MIT')
provides=('omadev')
conflicts=('omadev')
source_x86_64=("omadev-v${pkgver}-linux-amd64::${url}/releases/download/v${pkgver}/omadev-v${pkgver}-linux-amd64")
source_aarch64=("omadev-v${pkgver}-linux-arm64::${url}/releases/download/v${pkgver}/omadev-v${pkgver}-linux-arm64")
# Replace SKIP with the sha256 from the release SHA256SUMS at publish time.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  case "$CARCH" in
    x86_64) _bin="omadev-v${pkgver}-linux-amd64" ;;
    aarch64) _bin="omadev-v${pkgver}-linux-arm64" ;;
  esac
  install -Dm755 "${srcdir}/${_bin}" "${pkgdir}/usr/bin/omadev"
}
